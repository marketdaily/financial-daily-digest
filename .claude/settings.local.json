{
  "permissions": {
    "allow": [
      "Bash(claude --version)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash '/home/userdelvin/Delvin-agent/.claude/hooks/session-context.sh'",
            "statusMessage": "讀取跨視窗近況..."
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/home/userdelvin/Delvin-agent/.claude/hooks/block-mass-email.sh'",
            "statusMessage": "檢查寄信封鎖規則..."
          },
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/sync-track-data-before-deploy.sh\"",
            "statusMessage": "部署前同步最新戰績資料..."
          }
        ]
      }
    ]
  }
}